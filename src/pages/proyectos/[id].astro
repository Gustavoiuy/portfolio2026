---
import BackgroundArt from "@components/BackgroundArt.astro";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import projects from "@/data/projects.json";
import { Arrow, Github } from "@components/icons";
import {
  Astroo,
  React as ReactIcon,
  CSS,
  HTML,
  JavaScript,
  TypeScript,
  TailwindCSS,
  Zod,
  Zustand,
  ReactRouter,
  TanStack,
  Supabase,
  PostgreSQL,
  Figma,
  Web,
  Net,
} from "@components/icons/react";

export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))) satisfies GetStaticPaths;

const { project } = Astro.props;
const SKILL_ICONS: Record<string, any> = {
  Astro: Astroo,
  React: ReactIcon,
  CSS,
  HTML,
  JavaScript,
  TypeScript,
  "React Router": ReactRouter,
  "TanStack Query": TanStack,
  TailwindCSS,
  Zod,
  Zustand,
  Supabase,
  PostgreSQL,
  Figma,
  Net,
};

import AnimacionesQueImpactan from "@projects/animaciones-que-impactan.webp";
import GamePerfect from "@projects/game-perfect.webp";
import EcommerceFrontend from "@projects/ecommerce-frontend.webp";
import RobbuildOng from "@projects/robbuild-ong.webp";
import socialHub from "@projects/social-network-by-acuache.webp";
import Apinetcore from "@projects/apinet-core.webp";

const PROJECT_IMAGES: Record<string, any> = {
  "animaciones-que-impactan": AnimacionesQueImpactan,
  "game-perfect": GamePerfect,
  "ecommerce-frontend": EcommerceFrontend,
  "robbuild-ong": RobbuildOng,
  "apinet-core": Apinetcore,
  "social-network-by-acuache": socialHub,
};
const imageProject = PROJECT_IMAGES[project.id];
---

<Layout>
  <BackgroundArt />

  <main class="project-page pb-20 pt-6 sm:pt-10">
    <button
      id="arrow-back"
      type="button"
      class="back-button group"
      aria-label="Volver a proyectos"
    >
      <Arrow class="size-5 rotate-90 transition-transform duration-300 group-hover:-translate-x-1" />
      <span>Volver a proyectos</span>
    </button>

    <section class="project-hero mt-8 grid items-center gap-10 lg:mt-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
      <div class="order-2 lg:order-1">
        <p class="eyebrow">Caso de estudio</p>
        <h1 class="font-sans mt-3 text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl">
          {project.title}
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-slate-300 sm:text-lg">
          {project.description}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          {
            project.links.figma && (
              <a href={project.links.figma} class="external-link" target="_blank" rel="noopener noreferrer" aria-label={`Abrir diseño de ${project.title} en Figma`}>
                <Figma className="size-5" /> <span>Diseño</span>
              </a>
            )
          }
          {
            project.links.github && (
              <a href={project.links.github} class="external-link" target="_blank" rel="noopener noreferrer" aria-label={`Abrir repositorio de ${project.title} en GitHub`}>
                <Github class="size-5" /> <span>Código</span>
              </a>
            )
          }
          {
            project.links.web && (
              <a href={project.links.web} class="external-link external-link-primary" target="_blank" rel="noopener noreferrer" aria-label={`Abrir sitio web de ${project.title}`}>
                <Web className="size-5" /> <span>Ver proyecto</span>
              </a>
            )
          }
        </div>

        <div class="mt-10">
          <h2 class="section-label">Tecnologías</h2>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {
              project.skills.map((skill) => {
                if (skill === "SALIENT") return;
                const Icon = SKILL_ICONS[skill];
                return (
                  <span class="skill-chip">
                    {Icon && <Icon className="size-4" />}
                    <span>{skill}</span>
                  </span>
                );
              })
            }
          </div>
        </div>
      </div>

      <div class="project-visual order-1 lg:order-2" style={`--project-start: ${project.colorBG[0]}; --project-end: ${project.colorBG[1]}`}>
        <div class="visual-orb visual-orb-one"></div>
        <div class="visual-orb visual-orb-two"></div>
        <div class="image-frame">
          <Image
            transition:name={project.id}
            src={imageProject}
            layout="constrained"
            alt={`Vista principal del proyecto ${project.title}`}
            class="project-image"
          />
        </div>
      </div>
    </section>

    <section class="project-notes mt-16 grid gap-6 lg:mt-24 lg:grid-cols-2">
      <article class="note-panel">
        <div class="flex items-center gap-3">
          <span class="note-index">01</span>
          <h2 class="font-sans text-xl font-semibold tracking-tight text-white sm:text-2xl">Lo que aprendí</h2>
        </div>
        <ul class="mt-6 space-y-3">
          {
            project.success.map((item, index) => (
              <li class="note-item">
                <span class="note-bullet">{String(index + 1).padStart(2, "0")}</span>
                <p>{item}</p>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="note-panel">
        <div class="flex items-center gap-3">
          <span class="note-index">02</span>
          <h2 class="font-sans text-xl font-semibold tracking-tight text-white sm:text-2xl">Retos enfrentados</h2>
        </div>
        <ul class="mt-6 space-y-3">
          {
            project.challenges.map((item, index) => (
              <li class="note-item">
                <span class="note-bullet">{String(index + 1).padStart(2, "0")}</span>
                <p>{item}</p>
              </li>
            ))
          }
        </ul>
      </article>
    </section>
  </main>
</Layout>

<script>
  const handleAstroLoad = () => {
    const arrowBack = document.querySelector("#arrow-back") as HTMLButtonElement | null;
    if (arrowBack) arrowBack.onclick = () => history.back();
  };

  document.addEventListener("astro:page-load", handleAstroLoad);
</script>

<style>
  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: rgb(203 213 225);
    font-family: "Montserrat", sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    transition: color 200ms ease;
  }

  .back-button:hover { color: #67e8f9; }

  .eyebrow,
  .section-label {
    color: #67e8f9;
    font-family: "Montserrat", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .external-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 0.65rem;
    padding: 0.65rem 0.8rem;
    color: rgb(203 213 225);
    font-family: "Montserrat", sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    transition: transform 200ms ease, border-color 200ms ease, background-color 200ms ease, color 200ms ease;
  }

  .external-link:hover {
    transform: translateY(-2px);
    border-color: rgb(103 232 249 / 0.65);
    background: rgb(255 255 255 / 0.07);
    color: white;
  }

  .external-link-primary {
    border-color: rgb(103 232 249 / 0.65);
    background: rgb(6 182 212 / 0.13);
    color: #cffafe;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 999px;
    background: rgb(15 23 42 / 0.68);
    padding: 0.5rem 0.75rem;
    color: rgb(226 232 240);
    font-family: "Montserrat", sans-serif;
    font-size: 0.8125rem;
    transition: transform 200ms ease, border-color 200ms ease, background-color 200ms ease;
  }

  .skill-chip:hover {
    transform: translateY(-2px);
    border-color: rgb(103 232 249 / 0.55);
    background: rgb(8 47 73 / 0.5);
  }

  .project-visual {
    position: relative;
    isolation: isolate;
    padding: 1rem;
  }

  .image-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 1.25rem;
    background: linear-gradient(135deg, var(--project-start), var(--project-end));
    box-shadow: 0 24px 70px rgb(0 0 0 / 0.45);
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 450ms ease;
  }

  .project-visual:hover .image-frame {
    transform: translateY(-8px) rotate(0.5deg);
    box-shadow: 0 30px 85px rgb(34 211 238 / 0.2);
  }

  .project-image {
    display: block;
    width: 100%;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-visual:hover .project-image { transform: scale(1.025); }

  .visual-orb {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    filter: blur(34px);
    opacity: 0.45;
    animation: float 6s ease-in-out infinite;
  }

  .visual-orb-one {
    top: 0;
    right: 6%;
    width: 9rem;
    height: 9rem;
    background: var(--project-start);
  }

  .visual-orb-two {
    bottom: 2%;
    left: 0;
    width: 7rem;
    height: 7rem;
    background: var(--project-end);
    animation-delay: -3s;
  }

  .note-panel {
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 1rem;
    background: linear-gradient(145deg, rgb(15 23 42 / 0.82), rgb(2 6 23 / 0.5));
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .note-index {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 999px;
    background: rgb(6 182 212 / 0.15);
    color: #67e8f9;
    font-family: "Montserrat", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .note-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    border-radius: 0.75rem;
    padding: 0.75rem;
    color: rgb(203 213 225);
    transition: background-color 200ms ease, transform 200ms ease;
  }

  .note-item:hover {
    transform: translateX(4px);
    background: rgb(255 255 255 / 0.05);
  }

  .note-item p { font-size: 0.9375rem; line-height: 1.6; }

  .note-bullet {
    padding-top: 0.18rem;
    color: rgb(103 232 249 / 0.8);
    font-family: "Montserrat", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .project-hero,
  .project-notes {
    animation: reveal 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .project-notes { animation-delay: 120ms; }

  @keyframes reveal {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(10px, -12px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-hero,
    .project-notes,
    .visual-orb { animation: none; }
    .image-frame,
    .project-image,
    .external-link,
    .skill-chip,
    .note-item { transition: none; }
  }
</style>
